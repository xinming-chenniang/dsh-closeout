{
  "name": "dsh-closeout",
  "version": "0.8.0",
  "description": "Before you close an AI coding session or the DSH app itself: a verdict on whether you can archive or delete it — uncommitted work, unpushed commits, scratch files, handoff, pending restarts, broken profile bundles.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "ai-agent",
    "coding-agent",
    "git",
    "session",
    "closeout",
    "handoff",
    "cli"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./bin/closeout.mjs",
  "bin": {
    "closeout": "bin/closeout.mjs"
  },
  "files": [
    "bin",
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/closeout.test.mjs",
    "demo": "node bin/closeout.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xinming-chenniang/dsh-closeout.git"
  },
  "homepage": "https://github.com/xinming-chenniang/dsh-closeout#readme",
  "bugs": {
    "url": "https://github.com/xinming-chenniang/dsh-closeout/issues"
  }
}
